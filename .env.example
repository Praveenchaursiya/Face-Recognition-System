# Copy to .env and use a long random Flask secret.
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_PATH=database/attendance.db
MODEL_DIR=models
CAMERA_INDEX=0
RECOGNITION_THRESHOLD=0.45
FLASK_DEBUG=false
# Optional: creates the first administrator at startup. Otherwise use /setup once.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-first-run
